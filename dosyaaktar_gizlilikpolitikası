<script>
  function setLang(lang) {
    var tr = document.getElementById('doc-tr');
    var en = document.getElementById('doc-en');
    var btr = document.getElementById('btn-tr');
    var ben = document.getElementById('btn-en');
    var isTr = lang === 'tr';
    tr.style.display = isTr ? 'block' : 'none';
    en.style.display = isTr ? 'none' : 'block';
    btr.className = isTr ? 'active' : '';
    ben.className = isTr ? '' : 'active';
    document.documentElement.lang = isTr ? 'tr' : 'en';
    try { history.replaceState(null, '', isTr ? '#tr' : '#en'); } catch (e) {}
  }
  if (location.hash === '#en') { setLang('en'); }
