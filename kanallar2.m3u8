MAHSUN SPORTS - Canlı Maç İzle | HD Kalitede Spor Yayınları
    
    
    
    
    
    
    
    
    
    
    
    
    
    

    body{-webkit-animation:-amp-start 8s steps(1,end) 0s 1 normal both;-moz-animation:-amp-start 8s steps(1,end) 0s 1 normal both;-ms-animation:-amp-start 8s steps(1,end) 0s 1 normal both;animation:-amp-start 8s steps(1,end) 0s 1 normal both}@-webkit-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-moz-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-ms-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-o-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}body{-webkit-animation:none;-moz-animation:none;-ms-animation:none;animation:none}

    
        :root {
            --mahsun-orange: #FF9D00;
            --mahsun-pink: #FF0066;
            --mahsun-bg-dark: #0D0D10;
            --mahsun-bg-panel: rgba(22, 22, 26, 0.9);
            --text-white: #ffffff;
            --text-grey: #a0a0a0;
            --border-color: #2a2a2a;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        html {
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
        }
        
        body {
            -webkit-overflow-scrolling: touch;
            touch-action: manipulation;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--mahsun-bg-dark);
            background-image: radial-gradient(circle at 50% 0%, #301020 0%, #0D0D10 80%);
            background-attachment: fixed;
            color: var(--text-white);
            line-height: 1.6;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            max-width: 100vw;
        }

        /* Breaking News Ticker */
        .breaking-news {
            background: rgba(255, 0, 102, 0.08);
            border-bottom: 1px solid rgba(255, 0, 102, 0.2);
            color: #ddd;
            font-weight: 400;
            font-size: 13px;
            padding: 10px 0;
        }

        .breaking-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .breaking-tag {
            background: var(--mahsun-pink);
            color: white;
            padding: 3px 12px;
            margin-right: 15px;
            border-radius: 4px;
            font-weight: 600;
            box-shadow: 0 0 15px rgba(255, 0, 102, 0.3);
            letter-spacing: 1px;
            font-size: 11px;
        }

        .breaking-link {
            color: var(--mahsun-orange);
            font-weight: bold;
            text-decoration: none;
        }

        /* Header */
        .top-banner {
            background-color: rgba(13, 13, 16, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-color);
            height: 80px;
            position: sticky;
            top: 0;
            left: 0;
            right: 0;
            width: 100%;
            z-index: 1000;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .banner-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            width: 100%;
        }

        /* Logo - Mahsun Sports Style */
        .brand-logo {
            font-size: 28px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            text-decoration: none;
            transition: transform 0.3s;
        }
        
        .brand-logo:hover {
            transform: scale(1.02);
        }

        .text-mahsun {
            color: var(--text-white);
            margin-right: 8px;
            text-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
        }
        
        .text-spor {
            color: #000;
            background: linear-gradient(135deg, var(--mahsun-orange), #FF5E00);
            padding: 2px 12px;
            border-radius: 4px;
            transform: skew(-10deg);
            box-shadow: 0 0 20px rgba(255, 157, 0, 0.4);
            display: inline-block;
        }

        .nav-links {
            display: flex;
            gap: 25px;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-grey);
            text-decoration: none;
            padding: 8px 15px;
            border-radius: 5px;
            transition: all 0.3s ease;
            font-weight: 500;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            position: relative;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: var(--mahsun-orange);
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0%;
            height: 2px;
            background-color: var(--mahsun-orange);
            transition: 0.3s;
            box-shadow: 0 0 10px var(--mahsun-orange);
        }
        
        .nav-links a:hover::after,
        .nav-links a.active::after {
            width: 100%;
        }

        .hamburger-menu {
            display: none;
            flex-direction: column;
            cursor: pointer;
            padding: 5px;
            z-index: 1001;
        }

        .hamburger-menu span {
            width: 25px;
            height: 3px;
            background: var(--mahsun-orange);
            margin: 3px 0;
            border-radius: 2px;
            transition: all 0.3s ease;
        }

        .mobile-nav {
            position: fixed;
            top: 80px;
            left: 0;
            right: 0;
            background: rgba(13, 13, 16, 0.98);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid var(--border-color);
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            z-index: 999;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5);
        }

        .mobile-nav[hidden] {
            display: none;
        }

        .mobile-nav a {
            color: var(--text-grey);
            text-decoration: none;
            padding: 12px 15px;
            border-radius: 8px;
            transition: all 0.3s ease;
            font-weight: 500;
            text-align: center;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
        }

        .mobile-nav a:hover {
            background: var(--mahsun-orange);
            color: #000;
        }

        .main-container {
            min-height: calc(100vh - 80px);
            padding: 20px 0 0 0;
        }

        .content-wrapper {
            max-width: 1000px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Video Section */
        .video-section {
            background: var(--mahsun-bg-panel);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
            margin-bottom: 20px;
            border: 1px solid var(--border-color);
        }

        .video-player {
            position: relative;
            width: 100%;
            height: 550px;
            background: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .player-attributes {
            position: relative;
            width: 100%;
            height: 550px;
            background: #000;
        }

        /* Controls Section */
        .controls-section {
            background: var(--mahsun-bg-panel);
            backdrop-filter: blur(10px);
            padding: 20px;
            border-radius: 16px;
            margin-bottom: 20px;
            border: 1px solid var(--border-color);
        }

        /* Category Tabs */
        .head-grid {
            display: flex;
            flex-wrap: nowrap;
            justify-content: space-between;
            position: relative;
            padding: 8px 6px;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 12px;
            margin-bottom: 15px;
            gap: 3px;
            min-height: 50px;
            overflow-x: auto;
        }

        .head-grid::-webkit-scrollbar {
            height: 6px;
        }

        .head-grid::-webkit-scrollbar-track {
            background: transparent;
        }

        .head-grid::-webkit-scrollbar-thumb {
            background: rgba(255, 157, 0, 0.3);
            border-radius: 3px;
        }

        .head-grid > div {
            position: relative;
            padding: 12px 18px;
            border-radius: 12px;
            font-weight: 600;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            min-height: 45px;
            box-sizing: border-box;
            cursor: pointer;
            color: var(--text-grey);
            margin: 2px;
            transition: all 0.3s ease;
            border: 2px solid transparent;
            font-size: 11px;
            white-space: nowrap;
            flex-shrink: 0;
            min-width: 60px;
            max-width: 100%;
            background: none;
        }

        .head-grid > div:hover {
            color: var(--text-white);
            background: rgba(255, 255, 255, 0.05);
            border-color: var(--mahsun-orange);
            transform: translateY(-2px);
        }

        .head-grid > div:hover svg {
            fill: var(--mahsun-orange);
            transform: scale(1.2);
        }

        .head-grid > div svg {
            position: relative;
            width: 20px;
            height: 20px;
            fill: var(--text-grey);
            transition: all 0.3s ease;
            flex-shrink: 0;
        }

        .head-grid > div .tab-text {
            font-size: 10px;
            font-weight: 700;
            margin-left: 6px;
            display: none;
        }

        .head-grid > div.active .tab-text {
            display: inline-block;
        }

        .head-grid > div:first-child .tab-text {
            display: inline-block;
            margin-left: 0;
            font-size: 11px;
        }

        .head-grid > div.active {
            background: linear-gradient(135deg, var(--mahsun-orange), #FF5E00);
            color: #000;
            border-color: transparent;
            font-size: 10px;
            box-shadow: 0 8px 30px rgba(255, 157, 0, 0.4);
            transform: translateY(-2px);
        }

        .head-grid > div.active svg {
            fill: #000;
            transform: scale(1.2);
        }

        /* Match Cards */
        .matches-section {
            margin-top: 20px;
        }

        #matchesContainer {
            max-height: 500px;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 5px;
        }

        #matchesContainer::-webkit-scrollbar {
            width: 8px;
        }

        #matchesContainer::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.2);
            border-radius: 4px;
        }

        #matchesContainer::-webkit-scrollbar-thumb {
            background: var(--mahsun-orange);
            border-radius: 4px;
        }

        .mac {
            width: 100%;
            min-height: 70px;
            margin-bottom: 12px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 12px;
            padding: 16px 18px;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 1px solid var(--border-color);
            border-left: 3px solid transparent;
        }

        .mac:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 157, 0, 0.3);
            transform: translateX(3px);
        }

        .mac[selected] {
            background: linear-gradient(90deg, rgba(255, 0, 102, 0.1), transparent);
            border-left: 3px solid var(--mahsun-pink);
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
        }

        .match-takimlar {
            color: #eee;
            font-weight: 600;
            text-align: left;
            width: 100%;
            margin-bottom: 6px;
            font-size: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            line-height: 1.3;
        }

        .canli-badge {
            background-color: var(--mahsun-pink);
            color: white;
            font-size: 10px;
            padding: 3px 8px;
            border-radius: 4px;
            box-shadow: 0 0 5px var(--mahsun-pink);
            animation: pulse 1.5s infinite;
            white-space: nowrap;
        }

        @keyframes pulse {
            0% { opacity: 1; box-shadow: 0 0 8px var(--mahsun-pink); }
            50% { opacity: 0.7; box-shadow: 0 0 2px var(--mahsun-pink); }
            100% { opacity: 1; box-shadow: 0 0 8px var(--mahsun-pink); }
        }

        .match-alt {
            display: flex;
            justify-content: flex-start;
            align-items: center;
            width: 100%;
            margin-top: 4px;
            gap: 10px;
        }

        .match-saat {
            color: var(--mahsun-orange);
            font-weight: 700;
            font-size: 13px;
            text-shadow: 0 0 5px rgba(255, 157, 0, 0.3);
        }

        .match-divider {
            color: #666;
            font-size: 12px;
        }

        .match-lig {
            color: #aaa;
            font-size: 12px;
            font-weight: 500;
            text-transform: uppercase;
        }

        .mac[selected] .match-takimlar {
            color: var(--text-white);
        }

        .mac[selected] .match-saat {
            color: var(--mahsun-pink);
            text-shadow: 0 0 5px rgba(255, 0, 102, 0.4);
        }

        /* Ad Banner Styles */
        .ad-banner {
            width: 100%;
            display: flex;
            justify-content: center;
            margin: 10px 0;
        }

        .ad-banner.fullwidth {
            width: 100%;
        }

        .ad-banner amp-img {
            max-width: 728px;
            width: 100%;
            height: auto;
            border-radius: 8px;
        }

        .ad-banner a {
            display: block;
            width: 100%;
            max-width: 728px;
            text-align: center;
        }

        /* Info Box */
        .info-box {
            background: var(--mahsun-bg-panel);
            backdrop-filter: blur(10px);
            padding: 30px;
            margin-top: 25px;
            border-radius: 16px;
            border: 1px solid var(--border-color);
        }

        .info-box h1 {
            font-size: 32px;
            margin-bottom: 15px;
            color: var(--text-white);
            letter-spacing: 1px;
        }

        .info-box h1 span {
            color: var(--mahsun-orange);
            text-shadow: 0 0 20px rgba(255, 157, 0, 0.3);
        }

        .info-box h2 {
            font-size: 20px;
            color: var(--mahsun-orange);
            margin-top: 20px;
            margin-bottom: 10px;
        }

        .info-box p {
            margin-bottom: 15px;
            color: #ddd;
            line-height: 1.6;
        }

        .info-box ol {
            margin-left: 20px;
            margin-bottom: 20px;
            color: #ccc;
            line-height: 1.8;
        }

        .info-box strong {
            color: white;
        }

        /* Footer */
        .footer {
            background: #0b060d;
            padding: 40px 0;
            margin-top: 50px;
            border-top: 1px solid #222;
        }

        .footer-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 0 20px;
            text-align: center;
        }

        .footer p {
            color: #666;
            margin-bottom: 20px;
            font-size: 13px;
        }

        .social-icons {
            display: flex;
            justify-content: center;
            gap: 30px;
        }

        .social-icons a {
            color: #888;
            font-size: 14px;
            transition: 0.3s;
            text-decoration: none;
        }

        .social-icons a:hover {
            color: var(--mahsun-orange);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .banner-container {
                padding: 0 15px;
            }

            .nav-links {
                display: none;
            }

            .hamburger-menu {
                display: flex;
            }

            .brand-logo {
                font-size: 20px;
            }

            .top-banner {
                height: 70px;
            }

            .mobile-nav {
                top: 70px;
            }

            .main-container {
                padding: 15px 0 0 0;
            }

            .video-section {
                margin: 0 -15px 10px -15px;
                border-radius: 0;
            }

            .video-player {
                height: 280px;
            }

            .player-attributes {
                height: 100%;
            }

            .content-wrapper {
                padding: 0 15px;
            }

            .controls-section {
                padding: 15px;
            }

            #matchesContainer {
                max-height: 400px;
            }

            .mac {
                padding: 12px 14px;
                min-height: 60px;
                margin-bottom: 10px;
            }

            .match-takimlar {
                font-size: 13px;
                margin-bottom: 5px;
            }

            .canli-badge {
                font-size: 9px;
                padding: 2px 6px;
            }

            .match-saat {
                font-size: 12px;
            }

            .match-lig {
                font-size: 11px;
            }

            .info-box {
                padding: 20px;
            }

            .info-box h1 {
                font-size: 24px;
            }

            .info-box h2 {
                font-size: 18px;
            }

            .breaking-inner {
                flex-direction: column;
                gap: 8px;
                text-align: center;
            }

            .breaking-tag {
                margin-right: 8px;
                padding: 2px 6px;
                font-size: 10px;
            }

            .ad-banner amp-img {
                max-width: 100%;
            }

            .ad-banner a {
                max-width: 100%;
            }
        }

        @media (max-width: 480px) {
            .brand-logo {
                font-size: 18px;
            }

            .text-spor {
                padding: 2px 8px;
            }

            .head-grid > div {
                font-size: 9px;
                padding: 8px 10px;
                min-width: 40px;
            }

            .content-wrapper {
                padding: 0 10px;
            }

            .video-section {
                margin: 0 -10px 8px -10px;
            }

            .video-player {
                height: 230px;
            }

            .mac {
                padding: 10px 12px;
            }

            .match-takimlar {
                font-size: 12px;
                flex-wrap: wrap;
            }
        }
    



    
        
